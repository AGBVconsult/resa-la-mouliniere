# ── Next.js (Vercel) ─────────────────────────────────────────────────────────
# URL du déploiement Convex (publique, embarquée dans le bundle)
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# Clé de site Turnstile (publique)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# NextAuth — compte administrateur unique
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=

# Pont d'authentification Convex (voir docs/ops/AUTH_CONVEX.md)
CONVEX_AUTH_ISSUER=https://resa-la-mouliniere.vercel.app   # sans slash final, identique côté Convex
CONVEX_AUTH_PRIVATE_KEY=          # node scripts/generate-convex-auth-key.mjs

# ── Convex (dashboard → Environment Variables, voir docs/ops/SECRETS.md) ─────
# CONVEX_AUTH_ISSUER=https://resa-la-mouliniere.vercel.app
# CONVEX_AUTH_ENFORCEMENT=off     # développement uniquement, jamais en production
# TURNSTILE_SECRET_KEY=0x...
# RESEND_API_KEY=re_...
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
# APP_URL=https://lamouliniere.be # origine des liens e-mail, sans slash final
# ALLOW_SEED=true                 # développement/recette uniquement, jamais en production

# ── Tests E2E ────────────────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:3000
