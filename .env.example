# ---------------------------------------------------------------------------
# Resa La Moulinière — variables d'environnement (Next.js / Vercel)
# Copier en .env.local pour le développement. Ne jamais committer de valeurs.
# ---------------------------------------------------------------------------

# Convex (URL publique du déploiement, incluse dans le bundle client)
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# NextAuth
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://resa.example.be  # origine publique de l'app (http://localhost:3000 en dev)
AUTH_EMAIL=admin@example.be
AUTH_PASSWORD_HASH=               # node scripts/hash-password.mjs  (préféré)
# AUTH_PASSWORD=                  # repli en clair, à supprimer une fois le hash en place

# Pont NextAuth -> Convex (voir docs/SECURITE-SPRINT0.md)
CONVEX_AUTH_ISSUER=https://resa.example.be   # identique à AUTH_URL, sans slash final
CONVEX_JWT_PRIVATE_KEY=                      # node scripts/generate-convex-jwt-key.mjs

# ---------------------------------------------------------------------------
# Variables à définir SUR LE DÉPLOIEMENT CONVEX (dashboard > Settings > Environment
# variables, ou `npx convex env set NOM valeur`) — pas dans ce fichier :
#   CONVEX_AUTH_ISSUER      même valeur que ci-dessus (lue par convex/auth.config.ts)
#   RESEND_WEBHOOK_SECRET   "Signing secret" whsec_… du webhook inbound Resend
# ---------------------------------------------------------------------------
